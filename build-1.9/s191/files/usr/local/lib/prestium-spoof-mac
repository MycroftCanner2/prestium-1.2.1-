#!/bin/sh
# Prestium 1.9.1: called by udev for each new physical network device
dev="$1"
[ -n "$dev" ] && [ -e "/sys/class/net/$dev" ] || exit 0
old=$(cat "/sys/class/net/$dev/address" 2>/dev/null)
ip link set dev "$dev" down 2>/dev/null
if /usr/bin/macchanger -e "$dev" >/dev/null 2>&1; then
  new=$(cat "/sys/class/net/$dev/address" 2>/dev/null)
  if [ -n "$new" ] && [ "$new" != "$old" ]; then
    logger -t prestium-spoof-mac "$dev: MAC address spoofed (vendor part kept)"
    exit 0
  fi
fi
# failed: never let the real address out - disable the device
logger -t prestium-spoof-mac "$dev: MAC spoofing FAILED, disabling the device"
ip link set dev "$dev" down 2>/dev/null
drv=$(readlink -f "/sys/class/net/$dev/device/driver" 2>/dev/null)
dvp=$(basename "$(readlink -f "/sys/class/net/$dev/device" 2>/dev/null)")
[ -n "$drv" ] && [ -n "$dvp" ] && echo "$dvp" > "$drv/unbind" 2>/dev/null
exit 0
