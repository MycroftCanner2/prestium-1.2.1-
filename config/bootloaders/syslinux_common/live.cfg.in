label live-@FLAVOUR@
	menu label ^Prestium 2.0
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-nomodeset
	menu label Prestium 2.0 (nomodeset)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

label live-@FLAVOUR@-nocammic
	menu label Prestium 2.0 (camera and microphone off)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ prestium.nocammic
