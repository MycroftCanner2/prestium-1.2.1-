#!/bin/sh
# Prestium 2.0: install the "parity" packages (what 1.9.1.3 had as dependencies/recommends) and the
# extra firmware listed in /usr/share/prestium/build/optional-packages.txt. Names that the archive
# no longer has are skipped and logged instead of failing the build.
set -e
L=/usr/share/prestium/build/optional-packages.txt
[ -f "$L" ] || exit 0
export DEBIAN_FRONTEND=noninteractive
want=$(grep -v '^#' "$L" | grep -v '^$' | sort -u)
have=""; skip=""
for p in $want; do
	if apt-cache show --no-all-versions "$p" >/dev/null 2>&1; then have="$have $p"; else skip="$skip $p"; fi
done
echo "P: optional packages: $(echo $have | wc -w) available, skipped:$skip"
# shellcheck disable=SC2086
apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold $have || {
	echo "P: bulk install failed, installing one by one"
	for p in $have; do apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold "$p" || echo "P: optional package failed: $p"; done
}
echo "$skip" | tr ' ' '\n' | grep -v '^$' > /usr/share/prestium/build/optional-skipped.txt || true
