#!/bin/sh
# Prestium 2.0: AppArmor. Every profile Prestium ships is enforced, LibreWolf's included (1.9.1.3
# had it in complain mode). Profiles are compiled once here to catch syntax errors at build time.
set -e
for p in usr.share.librewolf.librewolf torbrowser.Browser.firefox usr.bin.pidgin system_tor usr.bin.i2pd; do
	f=/etc/apparmor.d/$p
	[ -e "$f" ] || { echo "W: no profile $p"; continue; }
	sed -i 's/ flags=(complain)//; s/flags=(complain) //' "$f"
	rm -f "/etc/apparmor.d/force-complain/$p" "/etc/apparmor.d/disable/$p"
	apparmor_parser -Q -K "$f" >/dev/null 2>&1 && echo "P: apparmor $p parses" || { echo "E: apparmor $p does not parse"; apparmor_parser -Q -K "$f"; exit 1; }
done
grep -q 'flags=(complain)' /etc/apparmor.d/usr.share.librewolf.librewolf && { echo "E: LibreWolf profile still in complain mode"; exit 1; }
touch /etc/apparmor.d/local/usr.share.librewolf.librewolf
