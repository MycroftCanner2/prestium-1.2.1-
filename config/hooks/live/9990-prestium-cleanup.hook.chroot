#!/bin/sh
# Prestium 2.0: final apt sources (signed-by keyrings), remove build-only material, clean caches.
set -e
B=/usr/share/prestium/build
install -m 644 "$B"/apt/* /etc/apt/sources.list.d/
# record what went in (kept in the image for reference)
dpkg-query -W -f='${Package}\t${Version}\n' > /usr/share/prestium/packages-2.0.txt
[ -f "$B/optional-skipped.txt" ] && cp "$B/optional-skipped.txt" /usr/share/prestium/optional-skipped-2.0.txt
rm -rf /usr/src/prestium-thirdparty "$B" /usr/share/prestium/opt-overlay
rm -f /usr/sbin/policy-rc.d.prestium
apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /tmp/* /root/.cache /root/.npm
echo "P: cleanup done"
