# Prestium: power actions and restarting i2pd. 2.0 r9: prestium-tunnel-hops (changes how many I2P
# hops protect you) is a protected setting now, see /etc/sudoers.d/prestium-sensitive.
user ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/sbin/poweroff, /usr/sbin/reboot, /usr/bin/systemctl restart i2pd
