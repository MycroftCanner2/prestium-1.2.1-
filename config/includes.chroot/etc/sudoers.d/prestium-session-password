# Prestium 1.9.1: first screen lock asks the live user to set a (screen lock) password.
# 2.0 r9: the administration password can only be set in the short window right after login
# (prestium-admin-password refuses otherwise); "close" ends that window early.
user ALL=(root) NOPASSWD: /usr/local/sbin/prestium-session-password status, /usr/local/sbin/prestium-session-password set, /usr/local/sbin/prestium-admin-password status, /usr/local/sbin/prestium-admin-password set, /usr/local/sbin/prestium-admin-password close
