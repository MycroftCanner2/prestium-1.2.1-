# Prestium 1.9.1: delete the session's files late in shutdown (see the script).
# Ordered Before=sysinit.target, so on shutdown it is stopped (ExecStop runs)
# only after every normal service and the desktop session have stopped.
[Unit]
Description=Prestium: delete session files from RAM at shutdown
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target umount.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/prestium-wipe-session
TimeoutStopSec=60

[Install]
WantedBy=sysinit.target
