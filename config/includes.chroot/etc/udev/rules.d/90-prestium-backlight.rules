# Prestium 2.0: members of group "video" (the live user) may set the screen and keyboard backlight
# (brightness keys, Menu > System > Brightness) without root. brightnessctl can also go through
# systemd-logind; this rule covers sessions where that is not available.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*kbd_backlight*", RUN+="/bin/chgrp video /sys/class/leds/%k/brightness", RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"
