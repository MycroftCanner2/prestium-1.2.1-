# Prestium 2.0 r11: session start. labwc runs this with its own full socket ($WAYLAND_DISPLAY), which
# the broker then locks (root-owned): nothing started here or later can use it.
# 1. lock the full socket, create the restricted socket for applications
/usr/local/bin/prestium-wl start >/dev/null 2>&1 || logger -t prestium "Wayland broker: start failed"
S=/run/prestium-wl/$(id -u)/apps
# 2. trusted session parts (panel, notifications, wallpaper, idle lock), started by the broker
/usr/local/bin/prestium-wl panel >/dev/null 2>&1
/usr/local/bin/prestium-wl scale >/dev/null 2>&1 &
# 3. D-Bus-activated programs get the restricted socket
dbus-update-activation-environment --systemd WAYLAND_DISPLAY="$S" \
  XDG_CURRENT_DESKTOP XDG_SESSION_TYPE MOZ_ENABLE_WAYLAND GDK_BACKEND QT_QPA_PLATFORM DISPLAY >/dev/null 2>&1
# 4. desktop programs: restricted socket
prestium-run nm-applet --indicator >/dev/null 2>&1
prestium-run lxpolkit >/dev/null 2>&1
prestium-run /usr/local/bin/prestium-safety-notify >/dev/null 2>&1
