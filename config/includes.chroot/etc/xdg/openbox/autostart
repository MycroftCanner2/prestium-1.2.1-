#
# These things are run when an Openbox X Session is started.
# You may place a similar script in $HOME/.config/openbox/autostart
# to run user-specific things.
#

# If you want to use GNOME config tools...
#
#if test -x /usr/lib/x86_64-linux-gnu/gnome-settings-daemon >/dev/null; then
#  /usr/lib/x86_64-linux-gnu/gnome-settings-daemon &
#elif which gnome-settings-daemon >/dev/null 2>&1; then
#  gnome-settings-daemon &
#fi

# If you want to use XFCE config tools...
#
#xfce-mcs-manager &

BG=""
if which hsetroot > /dev/null; then
	BG=hsetroot
else
	if which esetroot > /dev/null; then
		BG=esetroot
	else
		if which xsetroot > /dev/null; then
			BG=xsetroot
		fi
	fi
fi

test -z $BG || $BG -solid "#303030"

# Prestium 2.0: xfsettingsd (from xfce4-settings) for xfce4-display-settings: applies the display
# configuration and handles monitor hotplug (quick setup dialog / saved profiles), and publishes
# XSETTINGS (Prestium's GTK look; DPI from prestium-scale, see /etc/xdg/openbox/environment).
# Its keyboard shortcuts are disabled (/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/).
xfsettingsd &

# Prestium 2.0: touchpad choices saved by Menu > System > Touchpad (defaults: xorg.conf.d)
/usr/local/bin/prestium-touchpad --apply &

# the panel; ~/.config/tint2/tint2rc is generated at login by prestium-scale (scaled for HiDPI)
tint2 &

# Prestium 2.0: audio is PipeWire (+ WirePlumber, pipewire-pulse), started per user by systemd --user.
# pasystray is the panel's volume icon (left click: mute/volume, middle: mute, right: menu/pavucontrol).
pasystray --notify=none --volume-max=150 &

# Prestium 1.9: ClipIt is gone in trixie; Diodon (its Debian replacement) starts from /etc/xdg/autostart
