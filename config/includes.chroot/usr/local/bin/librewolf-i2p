#!/bin/sh
# 2.0 r9: an app is starting, so the window for setting the administration password ends now
sudo -n /usr/local/sbin/prestium-admin-password close >/dev/null 2>&1 || true
# Prestium: "I2P Browser" - LibreWolf through the
# I2P HTTP proxy 127.0.0.1:4444. .i2p sites go through I2P; other (clearnet)
# sites go through ONE I2P outproxy (acetone, http://proxy4uwdijqxac2bvdx4fuhem6njmiwukuk2gelejv2nzxka2xq.b32.i2p:3128), which sees every
# clearnet site you visit. HTTPS-Only mode is off on purpose (I2P sites are http).
# 1.9.1: fixed profile ~/.librewolf/prestium, seeded with an NSS database that
# distrusts the eMudhra (emSign) roots.
P="$HOME/.librewolf/prestium"
umask 077
if [ ! -e "$P/cert9.db" ]; then
  mkdir -p "$P" && cp /usr/local/share/prestium-nssdb/cert9.db /usr/local/share/prestium-nssdb/key4.db "$P/"
fi
exec /usr/bin/librewolf --profile "$P" "$@"
