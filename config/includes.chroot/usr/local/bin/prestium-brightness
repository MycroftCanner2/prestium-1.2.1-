#!/usr/bin/python3
# Prestium 2.0: screen brightness slider (brightnessctl; user is in group "video", see
# /etc/udev/rules.d/90-prestium-backlight.rules). The brightness keys work without it.
import subprocess, sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

def bctl(*a):
    try:
        return subprocess.run(["brightnessctl"] + list(a), capture_output=True, text=True, timeout=5)
    except Exception:
        return None

def current():
    r = bctl("-m", "-c", "backlight")
    if not r or r.returncode != 0 or not r.stdout.strip():
        return None, None
    f = r.stdout.strip().splitlines()[0].split(",")
    return f[0], int(f[3].rstrip("%"))

class Win(Gtk.Window):
    def __init__(self):
        super().__init__(title="Brightness")
        self.set_border_width(14); self.set_default_size(360, -1)
        self.set_position(Gtk.WindowPosition.MOUSE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); self.add(box)
        self.dev, pct = current()
        if self.dev is None:
            l = Gtk.Label(label="No adjustable backlight found.\nExternal monitors: use the monitor's own buttons.")
            l.set_line_wrap(True); box.pack_start(l, False, False, 0)
        else:
            row = Gtk.Box(spacing=8)
            row.pack_start(Gtk.Image.new_from_icon_name("display-brightness", Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
            self.scale.set_value(pct); self.scale.set_hexpand(True)
            self.scale.connect("value-changed", self.on_change)
            row.pack_start(self.scale, True, True, 0)
            box.pack_start(row, False, False, 0)
            box.pack_start(Gtk.Label(label="Device: %s  (keys: brightness up/down)" % self.dev, xalign=0), False, False, 0)
        self.pending = None
        close = Gtk.Button(label="Close"); close.connect("clicked", lambda *_: self.destroy())
        bb = Gtk.Box(); bb.pack_end(close, False, False, 0); box.pack_start(bb, False, False, 0)

    def on_change(self, s):
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(80, self.commit)

    def commit(self):
        self.pending = None
        bctl("-q", "-d", self.dev, "set", "%d%%" % int(self.scale.get_value()))
        return False

if __name__ == "__main__":
    w = Win(); w.connect("destroy", Gtk.main_quit); w.show_all(); Gtk.main()
