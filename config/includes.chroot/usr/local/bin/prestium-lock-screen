#!/bin/sh
# Prestium 1.9.1: lock the screen. 2.0 r10: swaylock (Wayland session lock: the compositor
# itself blanks every output, nothing else can draw or read input while locked). Started by
# swayidle (10 minutes idle, logind lock request, before suspend), the "Lock Screen" menu item
# and Super+L. The live user has no password at boot (autologin), so the first
# time we ask for one, as Tails does; without a password the screen isn't
# locked (an empty password would unlock it).
pgrep -u "$(id -u)" -x swaylock >/dev/null && exit 0
st=$(sudo -n /usr/local/sbin/prestium-session-password status 2>/dev/null)
if [ "$st" != set ]; then
  out=$(prestium-run zenity --forms --title "Lock Screen" \
        --text "Set a password to lock the screen.\nYou'll need it to unlock the screen and for administration prompts.\nIt lasts until you shut down." \
        --add-password "Password" --add-password "Confirm password" --separator '
' 2>/dev/null) || exit 0
  p1=$(printf '%s\n' "$out" | sed -n 1p); p2=$(printf '%s\n' "$out" | sed -n 2p)
  if [ -z "$p1" ] || [ "$p1" != "$p2" ]; then
    prestium-run zenity --error --title "Lock Screen" --text "The passwords are empty or don't match. The screen was not locked." 2>/dev/null
    exit 0
  fi
  if ! printf '%s\n' "$p1" | sudo -n /usr/local/sbin/prestium-session-password set >/dev/null 2>&1; then
    prestium-run zenity --error --title "Lock Screen" --text "Could not set the password. The screen was not locked." 2>/dev/null
    exit 0
  fi
  unset p1 p2 out
fi
exec swaylock -f -c 101010 --show-failed-attempts
