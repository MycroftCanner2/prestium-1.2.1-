#!/usr/bin/python3
# Prestium 2.0: display scale (HiDPI). 2.0 r10: Wayland (labwc). The compositor scales each output
# (fractional scaling), so every Wayland application, the panel and the browsers follow at once;
# no X resources, XSETTINGS, environment variables or panel rewrites are needed any more.
#   prestium-scale --apply      apply the setting to every output now (also run at login)
#   prestium-scale --login      the same (kept for compatibility)
#   prestium-scale --detect     print the automatic scale (100/125/150/175/200)
#   prestium-scale --effective  print the scale in use (setting, or the automatic one)
# Setting: ~/.config/prestium/scale contains "auto" (default) or a percentage.
# Automatic: DPI of the built-in (else first) output from its physical size (EDID):
# dpi = pixels / millimetres * 25.4, then the largest step <= dpi/96. Bogus sizes (VMs, projectors)
# give 100 %. Needs the full Wayland socket (output management): run from the session, not apps.
import json, os, subprocess, sys

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "prestium")
SETTING = os.path.join(CONF_DIR, "scale")
STEPS = (100, 125, 150, 175, 200)
WLR_RANDR = os.environ.get("PRESTIUM_WLR_RANDR", "wlr-randr")

def full_socket_env():
    env = dict(os.environ)
    rt = env.get("XDG_RUNTIME_DIR", "")
    try:
        name = open(os.path.join(rt, "prestium-wayland-display")).read().strip()
        if name and "/" not in name and not name.startswith("."):
            env["WAYLAND_DISPLAY"] = name
    except OSError:
        pass
    return env

def outputs():
    try:
        r = subprocess.run([WLR_RANDR, "--json"], capture_output=True, text=True, timeout=10, env=full_socket_env())
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        return [o for o in json.loads(r.stdout) if o.get("enabled")]
    except ValueError:
        return None

def detect_from(outs):
    if not outs:
        return 100, "no active output"
    outs = sorted(outs, key=lambda o: not o["name"].startswith(("eDP", "LVDS", "DSI")))
    o = outs[0]
    mode = next((m for m in o.get("modes", []) if m.get("current")), None)
    if not mode:
        return 100, "%s: no current mode" % o["name"]
    pw, ph = mode["width"], mode["height"]
    mw, mh = o.get("physical_size", {}).get("width", 0), o.get("physical_size", {}).get("height", 0)
    if o.get("transform") in ("90", "270", "flipped-90", "flipped-270"):
        pw, ph = ph, pw
    if (pw > ph) != (mw > mh):
        mw, mh = mh, mw
    if mw < 100 or mh < 60 or mw > 1000:
        return 100, "%s: physical size %dx%d mm not plausible" % (o["name"], mw, mh)
    dpi = pw / mw * 25.4
    if abs(dpi - ph / mh * 25.4) > dpi * 0.2:
        return 100, "%s: inconsistent physical size" % o["name"]
    ratio = dpi / 96.0
    s = max([x for x in STEPS if x / 100.0 <= ratio + 0.001] or [100])
    return s, "%s: %dx%d px, %dx%d mm, %.0f dpi" % (o["name"], pw, ph, mw, mh, dpi)

def detect():
    o = outputs()
    if o is None:
        return 100, "wlr-randr unavailable"
    return detect_from(o)

def setting():
    try:
        v = open(SETTING).read().strip().lower()
    except OSError:
        return "auto"
    if v in ("auto", ""):
        return "auto"
    try:
        n = int(v.rstrip("%"))
        return n if n in STEPS else "auto"
    except ValueError:
        return "auto"

def effective():
    s = setting()
    return detect()[0] if s == "auto" else s

def apply():
    outs = outputs()
    if outs is None:
        print("prestium-scale: no Wayland output management (wlr-randr)", file=sys.stderr)
        return 1
    s = setting()
    rc = 0
    for o in outs:
        scale = (detect_from([o])[0] if s == "auto" else s) / 100.0
        r = subprocess.run([WLR_RANDR, "--output", o["name"], "--scale", "%.2f" % scale],
                           capture_output=True, text=True, timeout=10, env=full_socket_env())
        if r.returncode != 0:
            print("prestium-scale: %s: %s" % (o["name"], r.stderr.strip()), file=sys.stderr)
            rc = 1
    if rc == 0:
        print(s if s != "auto" else detect_from(outs)[0])
    return rc

def main(a):
    if a == "--detect":
        s, why = detect(); print("%d %s" % (s, why)); return 0
    if a == "--effective":
        print(effective()); return 0
    if a in ("--apply", "--login"):
        return apply()
    print("usage: prestium-scale --apply|--detect|--effective", file=sys.stderr)
    return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else ""))
