#!/usr/bin/python3
# Prestium 2.0: Tor Connection Assistant.
# Shows Tor's bootstrap progress (read through the onion-grater control-port filter, read-only)
# and lets the user pick how Tor connects: Direct (default at boot), Snowflake, WebTunnel or obfs4
# bridges (built-in and/or pasted bridge lines). Changes are applied by the root helper
# /usr/local/sbin/prestium-tor-mode (sudo, validated input), which rewrites Tor's torrc drop-in and
# restarts Tor. Host names that Snowflake/WebTunnel need are resolved with DNS-over-HTTPS through
# the I2P outproxy, so a network that blocks or poisons DNS for Tor infrastructure can't stop them.
import json, os, re, socket, subprocess, threading
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

CONTROL = "/run/onion-grater/control"
HELPER = ["/usr/bin/sudo", "-n", "/usr/local/sbin/prestium-tor-mode"]

MODES = [
    ("direct", "Direct connection (default)",
     "Connect to the Tor network directly. Works on most networks."),
    ("snowflake", "Snowflake",
     "Looks like a video call (WebRTC) to volunteer proxies. Good when Tor is blocked. "
     "Its front and STUN host names are resolved through the I2P outproxy (DNS-over-HTTPS)."),
    ("webtunnel", "WebTunnel bridges",
     "Looks like ordinary HTTPS to a web site. Paste WebTunnel bridge lines below "
     "(from bridges.torproject.org). The bridge host name is resolved through the I2P outproxy."),
    ("obfs4", "obfs4 bridges",
     "Obfuscated bridges. Use the built-in ones and/or paste your own bridge lines below."),
]

def control_query(cmds, timeout=4):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(CONTROL)
    f = s.makefile("rwb", buffering=0)
    out = []
    f.write(b"AUTHENTICATE\r\n"); f.readline()
    for c in cmds:
        f.write((c + "\r\n").encode())
        lines = []
        while True:
            l = f.readline().decode(errors="replace").rstrip("\r\n")
            if not l:
                break
            lines.append(l)
            if re.match(r"^\d{3} ", l):
                break
        out.append(lines)
    try:
        f.write(b"QUIT\r\n")
    except Exception:
        pass
    s.close()
    return out

def bootstrap_status():
    try:
        r = control_query(["GETINFO status/bootstrap-phase", "GETINFO status/circuit-established"])
    except Exception as e:
        return None, "Tor is not reachable (%s). It may be restarting." % e.__class__.__name__, False
    phase = " ".join(r[0])
    m = re.search(r"PROGRESS=(\d+)", phase)
    summ = re.search(r'SUMMARY="([^"]*)"', phase)
    warn = re.search(r'WARNING="([^"]*)"', phase)
    circ = any("circuit-established=1" in l for l in r[1])
    pct = int(m.group(1)) if m else 0
    text = summ.group(1) if summ else "Starting"
    if warn and pct < 100:
        text += " - " + warn.group(1)
    return pct, text, circ

class Assistant(Gtk.Window):
    def __init__(self):
        super().__init__(title="Tor Connection Assistant")
        self.set_default_size(560, 520)
        self.set_border_width(12)
        self.busy = False
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(box)

        frame = Gtk.Frame(label=" Tor status ")
        fb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); fb.set_border_width(8)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.status = Gtk.Label(xalign=0); self.status.set_line_wrap(True)
        self.mode_label = Gtk.Label(xalign=0); self.mode_label.set_line_wrap(True)
        fb.pack_start(self.progress, False, False, 0)
        fb.pack_start(self.status, False, False, 0)
        fb.pack_start(self.mode_label, False, False, 0)
        frame.add(fb); box.pack_start(frame, False, False, 0)

        frame2 = Gtk.Frame(label=" How to connect ")
        mb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4); mb.set_border_width(8)
        self.radios = {}
        group = None
        for key, title, help_ in MODES:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, title)
            group = group or rb
            rb.set_tooltip_text(help_)
            rb.connect("toggled", self.on_mode)
            self.radios[key] = rb
            mb.pack_start(rb, False, False, 0)
        self.help = Gtk.Label(xalign=0); self.help.set_line_wrap(True)
        mb.pack_start(self.help, False, False, 4)
        self.builtin = Gtk.CheckButton(label="Also use Prestium's built-in bridges (from Tor Browser)")
        self.builtin.set_active(True)
        mb.pack_start(self.builtin, False, False, 0)
        self.rdv = Gtk.CheckButton(label="Snowflake rendezvous via the I2P outproxy (experimental)")
        self.rdv.set_tooltip_text("Sends Snowflake's broker request through i2pd's SOCKS proxy and the I2P "
                                  "outproxy. The WebRTC data still goes directly to the Snowflake proxy.")
        self.rdv.set_no_show_all(True)
        mb.pack_start(self.rdv, False, False, 0)
        lbl = Gtk.Label(label="Bridge lines (one per line, e.g. \"obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0\"):", xalign=0)
        lbl.set_line_wrap(True)
        mb.pack_start(lbl, False, False, 0)
        sw = Gtk.ScrolledWindow(); sw.set_min_content_height(110)
        self.text = Gtk.TextView(); self.text.set_wrap_mode(Gtk.WrapMode.CHAR); self.text.set_monospace(True)
        sw.add(self.text); mb.pack_start(sw, True, True, 0)
        frame2.add(mb); box.pack_start(frame2, True, True, 0)

        bb = Gtk.Box(spacing=6)
        self.apply_btn = Gtk.Button(label="Apply and connect"); self.apply_btn.connect("clicked", self.on_apply)
        self.reconnect_btn = Gtk.Button(label="Reconnect"); self.reconnect_btn.connect("clicked", self.on_reconnect)
        close = Gtk.Button(label="Close"); close.connect("clicked", lambda *_: self.destroy())
        bb.pack_start(self.apply_btn, False, False, 0)
        bb.pack_start(self.reconnect_btn, False, False, 0)
        bb.pack_end(close, False, False, 0)
        box.pack_start(bb, False, False, 0)

        self.load_state()
        self.on_mode(None)
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)

    def helper(self, args, stdin=None):
        try:
            r = subprocess.run(HELPER + args, input=stdin, capture_output=True, text=True, timeout=900)
            return json.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {"ok": False, "error": r.stderr.strip()[-300:]}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def load_state(self):
        st = self.helper(["status"])
        feats = self.helper(["features"])
        if feats.get("snowflake_proxy"):
            self.rdv.set_no_show_all(False); self.rdv.show()
        mode = st.get("mode", "direct")
        if mode in self.radios:
            self.radios[mode].set_active(True)
        self.builtin.set_active(st.get("builtin", True))
        self.rdv.set_active(bool(st.get("snowflake_i2p_rendezvous")))
        self.describe(st)

    def describe(self, st):
        mode = st.get("mode", "direct")
        title = dict((k, t) for k, t, _ in MODES).get(mode, mode)
        txt = "Current mode: %s" % title
        if mode != "direct":
            txt += " (%d bridge line%s)" % (st.get("bridges", 0), "" if st.get("bridges", 0) == 1 else "s")
        pins = st.get("pinned") or {}
        if pins:
            txt += "\nResolved through the I2P outproxy: " + ", ".join(sorted(pins))
        if st.get("dns_errors"):
            txt += "\nSome look-ups failed (I2P may still be starting): " + ", ".join(sorted(st["dns_errors"]))
        self.mode_label.set_text(txt)

    def selected(self):
        return next(k for k, rb in self.radios.items() if rb.get_active())

    def on_mode(self, _w):
        m = self.selected()
        self.help.set_text(dict((k, h) for k, _, h in MODES)[m])
        self.builtin.set_sensitive(m in ("obfs4", "snowflake"))
        self.rdv.set_sensitive(m == "snowflake")
        self.text.set_sensitive(m != "direct")

    def refresh(self):
        def work():
            pct, text, circ = bootstrap_status()
            GLib.idle_add(self.show_status, pct, text, circ)
        threading.Thread(target=work, daemon=True).start()
        return True

    def show_status(self, pct, text, circ):
        if pct is None:
            self.progress.set_fraction(0); self.progress.set_text("not connected")
        else:
            self.progress.set_fraction(pct / 100.0)
            self.progress.set_text("%d%%%s" % (pct, " - connected" if pct >= 100 and circ else ""))
        if not self.busy:
            self.status.set_text(text)
        return False

    def run_bg(self, label, args, stdin=None):
        self.busy = True
        self.apply_btn.set_sensitive(False); self.reconnect_btn.set_sensitive(False)
        self.status.set_text(label)
        def work():
            res = self.helper(args, stdin)
            GLib.idle_add(self.done, res)
        threading.Thread(target=work, daemon=True).start()

    def done(self, res):
        self.busy = False
        self.apply_btn.set_sensitive(True); self.reconnect_btn.set_sensitive(True)
        if res.get("ok"):
            self.status.set_text("Tor restarted; waiting for it to connect ...")
            if "mode" in res:
                self.describe(res)
        else:
            dlg = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                                    buttons=Gtk.ButtonsType.CLOSE, text="Could not apply the change")
            dlg.format_secondary_text(res.get("error") or "unknown error")
            dlg.run(); dlg.destroy()
        return False

    def on_apply(self, _b):
        buf = self.text.get_buffer()
        bridges = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        req = {"mode": self.selected(), "bridges": bridges, "builtin": self.builtin.get_active(),
               "snowflake_i2p_rendezvous": self.rdv.get_active()}
        msg = "Applying ..."
        if req["mode"] in ("snowflake", "webtunnel"):
            msg = "Resolving host names through the I2P outproxy (can take a minute), then restarting Tor ..."
        self.run_bg(msg, ["apply"], json.dumps(req))

    def on_reconnect(self, _b):
        self.run_bg("Restarting Tor ...", ["reconnect"])

if __name__ == "__main__":
    w = Assistant()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
