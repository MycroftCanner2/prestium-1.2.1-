#!/usr/bin/python3
# Prestium 2.0: touchpad settings. Defaults (tap to click, natural scrolling, disable while typing):
# /etc/xdg/labwc/rc.xml. 2.0 r10: Wayland (labwc). 2.0 r11: changes made here are saved in
# ~/.config/prestium/touchpad.json; root (prestium-wl-config) copies the four checked values into
# the compositor's root-owned configuration and labwc reloads it, so they apply at once.
import json, os, re, signal, subprocess, sys

XDG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CONF = os.path.join(XDG, "prestium", "touchpad.json")
DEFAULTS = {"tapping": True, "natural_scrolling": True, "disable_while_typing": True, "speed": 0.0}

def load():
    c = dict(DEFAULTS)
    try:
        c.update({k: v for k, v in json.load(open(CONF)).items() if k in DEFAULTS})
    except Exception:
        pass
    return c

def touchpads():
    """Names of the touchpads libinput knows (best effort: /proc/bus/input/devices)."""
    names = []
    try:
        for block in open("/proc/bus/input/devices").read().split("\n\n"):
            m = re.search(r'^N: Name="(.*)"$', block, re.M)
            if m and re.search(r"touchpad|trackpad|synaptics|elan.*tp|glidepoint", m.group(1), re.I):
                names.append(m.group(1))
    except OSError:
        pass
    return [(n, n) for n in names]

def apply(c):
    """Save, then have root rewrite the compositor's configuration and labwc reload it."""
    save(c)
    r = subprocess.run(["sudo", "-n", "/usr/local/sbin/prestium-wl-config"], capture_output=True, text=True)
    if r.returncode != 0:
        return -1
    pid = os.environ.get("LABWC_PID", "")
    if pid.isdigit():
        try:
            os.kill(int(pid), signal.SIGHUP)        # what "labwc --reconfigure" does
        except OSError:
            pass
    else:
        subprocess.run(["labwc", "--reconfigure"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return len(touchpads())

def save(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(c, f, indent=1)

def gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    c = load()
    w = Gtk.Window(title="Touchpad"); w.set_border_width(14); w.set_default_size(380, -1)
    w.set_position(Gtk.WindowPosition.CENTER)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); w.add(box)
    pads = touchpads()
    info = Gtk.Label(xalign=0); info.set_line_wrap(True)
    info.set_text(("Touchpad: " + ", ".join(n for _, n in pads)) if pads else "No touchpad found (settings are kept for when one is connected).")
    box.pack_start(info, False, False, 0)
    checks = {}
    for k, label in (("tapping", "Tap to click"), ("natural_scrolling", "Natural scrolling (content follows your fingers)"),
                     ("disable_while_typing", "Disable while typing")):
        cb = Gtk.CheckButton(label=label); cb.set_active(bool(c[k])); checks[k] = cb
        box.pack_start(cb, False, False, 0)
    box.pack_start(Gtk.Label(label="Pointer speed", xalign=0), False, False, 4)
    speed = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -1.0, 1.0, 0.05)
    speed.set_value(float(c["speed"])); speed.add_mark(0.0, Gtk.PositionType.BOTTOM, "default")
    box.pack_start(speed, False, False, 0)
    status = Gtk.Label(xalign=0); box.pack_start(status, False, False, 0)
    def on_apply(*_):
        nc = {k: cb.get_active() for k, cb in checks.items()}; nc["speed"] = round(speed.get_value(), 2)
        n = apply(nc)
        status.set_text("Could not apply the settings." if n < 0 else
                        "Saved%s." % (" and applied to %d touchpad%s" % (n, "" if n == 1 else "s") if n else ""))
    def on_reset(*_):
        for k, cb in checks.items(): cb.set_active(DEFAULTS[k])
        speed.set_value(DEFAULTS["speed"])
    bb = Gtk.Box(spacing=6)
    a = Gtk.Button(label="Apply"); a.connect("clicked", on_apply)
    r = Gtk.Button(label="Defaults"); r.connect("clicked", on_reset)
    cl = Gtk.Button(label="Close"); cl.connect("clicked", lambda *_: w.destroy())
    bb.pack_start(a, False, False, 0); bb.pack_start(r, False, False, 0); bb.pack_end(cl, False, False, 0)
    box.pack_start(bb, False, False, 0)
    w.connect("destroy", Gtk.main_quit); w.show_all(); Gtk.main()

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--apply":
        if os.path.exists(CONF):          # nothing saved: the defaults in /etc/xdg/labwc/rc.xml apply
            apply(load())
        sys.exit(0)
    gui()
