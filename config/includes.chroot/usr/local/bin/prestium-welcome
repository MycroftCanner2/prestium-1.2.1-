#!/bin/sh
# Prestium 2.0 r9: at login, offer the optional administration password (Tails-style). It can only
# be set now, before any app runs; answering this dialog either way ends that window.
st=$(sudo -n /usr/local/sbin/prestium-admin-password status 2>/dev/null)
[ "$st" = open ] || exit 0
TXT="Optional: set an administration password for this session.

With one, changing the Tor connection or bridges, the I2P tunnel hops, a manual I2P reseed file
or the clock asks for it every time, so a compromised app can't change them silently.
Without one, those settings stay unprotected for this session.

You can only set it now. It lasts until you shut down."
while :; do
  out=$(zenity --forms --title "Welcome to Prestium" --text "$TXT" --ok-label "Set password" \
        --cancel-label "No password" --add-password "Password" --add-password "Confirm password" \
        --separator '
' 2>/dev/null) || { sudo -n /usr/local/sbin/prestium-admin-password close >/dev/null 2>&1; exit 0; }
  p1=$(printf '%s\n' "$out" | sed -n 1p); p2=$(printf '%s\n' "$out" | sed -n 2p)
  if [ -z "$p1" ] || [ "$p1" != "$p2" ]; then
    zenity --error --title "Welcome to Prestium" --text "The passwords are empty or don't match." 2>/dev/null
    continue
  fi
  if err=$(printf '%s\n' "$p1" | sudo -n /usr/local/sbin/prestium-admin-password set 2>&1); then
    unset p1 p2 out
    zenity --info --title "Welcome to Prestium" --text "Administration password set." 2>/dev/null
  else
    unset p1 p2 out
    zenity --error --title "Welcome to Prestium" --text "No administration password was set: $err" 2>/dev/null
  fi
  exit 0
done
