#!/bin/sh
# Prestium 2.0 r10: the restricted Wayland socket for applications ($XDG_RUNTIME_DIR/wayland-apps).
#   apps-socket start   create it (once per session) and wait until it accepts clients
#   apps-socket name    print its name (for WAYLAND_DISPLAY)
S=wayland-apps
case "$1" in
  name) echo "$S"; exit 0 ;;
  start)
    [ -n "$XDG_RUNTIME_DIR" ] || exit 1
    [ -S "$XDG_RUNTIME_DIR/$S" ] && exit 0
    setsid /usr/local/lib/prestium/wl-context --socket "$XDG_RUNTIME_DIR/$S" --app-id prestium-apps \
      --engine org.prestium.session -- sleep infinity </dev/null >/dev/null 2>&1 &
    i=0; while [ $i -lt 50 ]; do [ -S "$XDG_RUNTIME_DIR/$S" ] && exit 0; sleep 0.1; i=$((i+1)); done
    logger -t prestium "restricted Wayland socket not created; applications use Xwayland"
    exit 1 ;;
esac
echo "usage: apps-socket start|name" >&2; exit 2
