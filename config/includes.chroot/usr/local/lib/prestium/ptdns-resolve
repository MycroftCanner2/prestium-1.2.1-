#!/usr/bin/python3
# Prestium 2.0: resolve the few hostnames Tor's pluggable transports need (Snowflake fronts/STUN,
# meek front, WebTunnel bridge host) with DNS-over-HTTPS, tunnelled through I2P: the HTTPS request
# goes to i2pd's HTTP proxy (127.0.0.1:4444), which hands it to the configured I2P outproxy
# (acetone, proxy4uwdijqxac2bvdx4fuhem6njmiwukuk2gelejv2nzxka2xq.b32.i2p). Tor traffic itself never
# goes through I2P; only these lookups do, so a local network that blocks or poisons DNS for Tor
# infrastructure cannot stop the transports from finding their servers.
#
# Runs as the unprivileged user "prestium-ptdns" (the firewall lets that uid reach 127.0.0.1:4444
# and nothing else). Prints JSON {"host": ["ip", ...], ...} on stdout; IPv4 only (IPv6 is off).
# Two independent DoH providers are asked; an answer is used only if it is a public IPv4 address,
# and when both answer, only addresses both agree on are kept (or the union if they never overlap,
# which is normal for CDNs, after both returned valid public addresses).
import ipaddress, json, re, ssl, sys, urllib.parse, urllib.request

PROXY = "http://127.0.0.1:4444"
PROVIDERS = [
    ("cloudflare", "https://cloudflare-dns.com/dns-query?name=%s&type=A"),
    ("quad9", "https://dns.quad9.net:5053/dns-query?name=%s&type=A"),
    ("google", "https://dns.google/resolve?name=%s&type=A"),
]
HOST_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$", re.I)
TIMEOUT = 90   # I2P tunnels can be slow to build

def query(url_tmpl, host):
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({"https": PROXY, "http": PROXY}),
                                         urllib.request.HTTPSHandler(context=ssl.create_default_context()))
    req = urllib.request.Request(url_tmpl % urllib.parse.quote(host), headers={"Accept": "application/dns-json"})
    with opener.open(req, timeout=TIMEOUT) as r:
        data = json.loads(r.read(65536).decode())
    ips = []
    for a in data.get("Answer", []) or []:
        if a.get("type") == 1:
            try:
                ip = ipaddress.IPv4Address(a.get("data", ""))
            except ValueError:
                continue
            if ip.is_global:
                ips.append(str(ip))
    return ips

def main(hosts):
    out, errors = {}, {}
    for h in hosts:
        h = h.strip().lower().rstrip(".")
        if not HOST_RE.match(h):
            errors[h] = "invalid hostname"; continue
        answers = {}
        for name, tmpl in PROVIDERS:
            try:
                ips = query(tmpl, h)
                if ips:
                    answers[name] = ips
            except Exception as e:
                errors.setdefault(h, []).append("%s: %s" % (name, e.__class__.__name__))
            if len(answers) >= 2:
                break
        if not answers:
            continue
        sets = [set(v) for v in answers.values()]
        common = set.intersection(*sets)
        out[h] = sorted(common) if common else sorted(set.union(*sets))[:4]
    json.dump({"resolved": out, "errors": errors}, sys.stdout)
    return 0 if out else 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
