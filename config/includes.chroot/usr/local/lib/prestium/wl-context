#!/usr/bin/python3
"""Prestium 2.0 r10: run a program with its own Wayland socket inside a security context
(wp-security-context-v1). The compositor (labwc) marks every client of that socket as sandboxed
and hides the privileged protocols from it: screen capture (screencopy, export-dmabuf), virtual
keyboard and pointer (input injection), input methods, clipboard managers (data-control), other
windows (foreign-toplevel), session lock, layer-shell, output and gamma control.

  prestium-wl-context --socket PATH --app-id ID [--engine NAME] -- COMMAND [ARG...]

PATH is created (mode 0600), registered with the compositor of $WAYLAND_DISPLAY and removed when
COMMAND exits; the compositor stops accepting clients on it then too (close_fd hang-up). Bind PATH
into the sandbox as its wayland socket and never give the sandbox the real one.
Fails closed: if the compositor has no security-context support or refuses, COMMAND isn't run.
Talks the Wayland wire protocol directly (no Python bindings needed on the image).
"""
import array, os, signal, socket, struct, subprocess, sys

def fail(msg, rc=1):
    print("prestium-wl-context: " + msg, file=sys.stderr)
    sys.exit(rc)

def wstring(s):
    b = s.encode() + b"\0"
    return struct.pack("=I", len(b)) + b + b"\0" * (-len(b) % 4)

class Conn:
    def __init__(self, path):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.connect(path)
        self.buf = b""
        self.next_id = 2

    def new_id(self):
        i = self.next_id; self.next_id += 1; return i

    def send(self, obj, opcode, payload=b"", fds=()):
        msg = struct.pack("=II", obj, ((8 + len(payload)) << 16) | opcode) + payload
        anc = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))] if fds else []
        self.s.sendmsg([msg], anc)

    def events(self):
        while True:
            while len(self.buf) >= 8:
                obj, so = struct.unpack("=II", self.buf[:8])
                size, op = so >> 16, so & 0xffff
                if len(self.buf) < size:
                    break
                body, self.buf = self.buf[8:size], self.buf[size:]
                yield obj, op, body
            d = self.s.recv(65536)
            if not d:
                raise ConnectionError("compositor closed the connection")
            self.buf += d

    def roundtrip(self, on_event):
        cb = self.new_id()
        self.send(1, 0, struct.pack("=I", cb))              # wl_display.sync
        for obj, op, body in self.events():
            if obj == 1 and op == 0:                         # wl_display.error
                eobj, code = struct.unpack("=II", body[:8])
                n = struct.unpack("=I", body[8:12])[0]
                raise RuntimeError("protocol error on object %d (code %d): %s"
                                   % (eobj, code, body[12:12 + n - 1].decode(errors="replace")))
            if obj == cb:
                return
            on_event(obj, op, body)

def main(argv):
    try:
        sep = argv.index("--")
    except ValueError:
        fail("usage: prestium-wl-context --socket PATH --app-id ID [--engine NAME] -- COMMAND...", 2)
    opts, cmd = argv[:sep], argv[sep + 1:]
    o = dict(zip(opts[0::2], opts[1::2]))
    path, app = o.get("--socket"), o.get("--app-id")
    engine = o.get("--engine", "org.prestium.bwrap")
    if not path or not app or not cmd or len(opts) % 2:
        fail("--socket, --app-id and a command are required", 2)
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    disp = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    real = disp if disp.startswith("/") else os.path.join(rt, disp)
    if not os.path.exists(real):
        fail("no Wayland compositor at %s" % real)

    c = Conn(real)
    reg = c.new_id()
    c.send(1, 1, struct.pack("=I", reg))                    # wl_display.get_registry
    found = {}
    def on_global(obj, op, body):
        if obj == reg and op == 0:
            name = struct.unpack("=I", body[:4])[0]
            n = struct.unpack("=I", body[4:8])[0]
            iface = body[8:8 + n - 1].decode()
            ver = struct.unpack("=I", body[8 + n + (-n % 4):][:4])[0]
            found[iface] = (name, ver)
    c.roundtrip(on_global)
    if "wp_security_context_manager_v1" not in found:
        fail("the compositor has no security-context support; refusing to run %s unsandboxed" % cmd[0])
    name, _ver = found["wp_security_context_manager_v1"]
    mgr = c.new_id()
    c.send(reg, 0, struct.pack("=I", name) + wstring("wp_security_context_manager_v1")
           + struct.pack("=II", 1, mgr))                    # wl_registry.bind

    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    old = os.umask(0o177)
    lis = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    lis.bind(path)
    os.umask(old)
    lis.listen(16)
    close_r, close_w = os.pipe()
    ctx = c.new_id()
    c.send(mgr, 1, struct.pack("=I", ctx), fds=(lis.fileno(), close_r))   # create_listener
    c.send(ctx, 1, wstring(engine))                         # set_sandbox_engine
    c.send(ctx, 2, wstring(app))                            # set_app_id
    c.send(ctx, 3, wstring(str(os.getpid())))               # set_instance_id
    c.send(ctx, 4)                                          # commit
    try:
        c.roundtrip(lambda *a: None)
    except Exception as e:
        os.unlink(path)
        fail("the compositor refused the security context: %s" % e)
    lis.close(); os.close(close_r)
    c.s.close()

    env = dict(os.environ)
    env.pop("PRESTIUM_WL_CONTEXT_FD", None)
    # the child must not inherit the pipe: the context lives exactly as long as this process
    os.set_inheritable(close_w, False)
    p = subprocess.Popen(cmd, env=env)
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda n, f: p.send_signal(n))
    rc = p.wait()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    os.close(close_w)
    return rc if rc >= 0 else 128 - rc

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
