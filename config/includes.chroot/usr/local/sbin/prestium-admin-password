#!/bin/sh
# Prestium 2.0 r9: optional administration password (Tails-style), set once, right after login.
#   prestium-admin-password status      prints "set", "open" (can be set now) or "closed"
#   prestium-admin-password set         reads the password on stdin (window must be open)
#   prestium-admin-password close       ends the window without setting a password
# Once set, the protected settings in /etc/sudoers.d/prestium-sensitive (Tor connection, I2P hops,
# manual reseed file, clock) ask for it every time (sudo rootpw, never cached). It can only be set
# while /run/prestium/admin-window exists and within 15 minutes of boot, before any app could have
# been compromised; otherwise a compromised app could simply set it itself and then use it.
# Fails closed: the sudoers file is switched to "password required" before the password is set.
set -u
R=${PRESTIUM_ROOT:-}                       # tests only
W=$R/run/prestium/admin-window
FLAG=$R/run/prestium/admin-password.set
SUDOERS=$R/etc/sudoers.d/prestium-sensitive
TPL=$R/usr/share/prestium/sudoers/sensitive-password
MAXUP=${PRESTIUM_ADMIN_WINDOW_SECS:-900}
UPTIME=${PRESTIUM_UPTIME_FILE:-/proc/uptime}
CHPASSWD=${PRESTIUM_CHPASSWD:-chpasswd}
VISUDO=${PRESTIUM_VISUDO:-visudo}
FLAGCMD=${PRESTIUM_SAFETY_FLAG:-/usr/local/lib/prestium/safety-flag}

window_open() {
  [ -e "$W" ] || return 1
  up=$(cut -d. -f1 "$UPTIME" 2>/dev/null) || return 1
  [ -n "$up" ] && [ "$up" -lt "$MAXUP" ]
}

case "${1:-}" in
  status)
    if [ -e "$FLAG" ]; then echo set; elif window_open; then echo open; else echo closed; fi ;;
  close)
    rm -f "$W"; echo ok ;;
  set)
    [ -e "$FLAG" ] && { echo "an administration password is already set" >&2; exit 1; }
    window_open || { rm -f "$W"; echo "the administration password can only be set right after login" >&2; exit 1; }
    rm -f "$W"                               # one attempt per boot
    IFS= read -r pw || { echo "no password given" >&2; exit 1; }
    [ -n "$pw" ] || { echo "empty password" >&2; exit 1; }
    case "$pw" in *:*) echo "':' is not allowed" >&2; exit 1 ;; esac
    T=$(mktemp "$SUDOERS.XXXXXX") || exit 1
    cat "$TPL" > "$T" && chmod 0440 "$T" && "$VISUDO" -cf "$T" >/dev/null 2>&1 || {
      rm -f "$T"; echo "could not prepare the sudo rules; no password was set" >&2; exit 1; }
    mv -f "$T" "$SUDOERS" || { rm -f "$T"; echo "could not install the sudo rules; no password was set" >&2; exit 1; }
    # from here on the protected settings need the root password (locked until chpasswd succeeds)
    if ! printf 'root:%s\n' "$pw" | "$CHPASSWD"; then
      "$FLAGCMD" set admin-password "Setting the administration password failed. Protected settings (Tor connection, I2P hops, clock) are locked until restart." 2>/dev/null
      echo "could not set the password; protected settings are locked until restart" >&2; exit 3
    fi
    unset pw
    : > "$FLAG"; echo ok ;;
  *) echo "usage: $0 status|set|close" >&2; exit 2 ;;
esac
