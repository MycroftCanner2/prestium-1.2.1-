#!/bin/sh
# Prestium: give i2pd a fresh random port each boot (so the port is no stable fingerprint).
# The port is opened inbound for IPv4 only, so peers can connect and the router is not "firewalled".
# 2.0 r5: the rule lives in ferm.conf, which reads the port from /run/prestium/i2pd.port (via
# /usr/local/lib/prestium/i2pd-port-get), so a ferm reload (e.g. by the Tor Connection Assistant)
# keeps it. 1.8-2.0 r4 inserted iptables rules here instead, for IPv4 and IPv6, which a ferm reload
# wiped. IPv6 stays closed. UPnP is off, so nothing asks the router to forward the port.
# 2.0 r4 (security audit): /var/lib/i2pd belongs to i2pd, so i2pd.conf is read and replaced only
# through /usr/local/lib/prestium/safefile (refuses a symlink or special file; new file created by
# root in the same directory, then renamed over the name), never written through by path.
set -e
SAFE=/usr/local/lib/prestium/safefile
PORT=$(shuf -i 10000-30000 -n 1)
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
$SAFE read /var/lib/i2pd i2pd.conf > "$TMP"
grep -q '^\[' "$TMP" || { echo "prestium-i2pd-port: i2pd.conf has no sections, not touched" >&2; exit 1; }
# Only the global "port" (before the first [section]) is touched.
awk -v p="$PORT" '
  !done && /^\[/ { print "port = " p; print ""; done=1 }
  !done && /^port[ \t]*=/ { next }
  { print }
' "$TMP" | $SAFE write /var/lib/i2pd i2pd.conf 2000 2000 0644
# /run/prestium is root's (0755); write the port atomically, then let ferm pick it up.
install -d -o root -g root -m 0755 /run/prestium
PF=$(mktemp /run/prestium/.i2pd.port.XXXXXX)
echo "$PORT" > "$PF"
chmod 0644 "$PF"
mv -f "$PF" /run/prestium/i2pd.port
set +e
# --no-block: this runs inside i2pd's start job; ferm reloads atomically (iptables-restore)
/usr/bin/systemctl --no-block reload-or-restart ferm.service
exit 0
