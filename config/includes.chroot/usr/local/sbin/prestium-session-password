#!/bin/sh
# Prestium 1.9.1: let the live user set a session password once (Tails-style),
# needed to lock the screen. "status" prints set/unset; "set" reads the new
# password from stdin and only works while no password is set (so it can't be
# used to change an existing password without knowing it).
set -u
U=user
cur=$(getent shadow "$U" | cut -d: -f2)
case "${1:-}" in
  status)
    case "$cur" in ""|"!"|"*"|"!*") echo unset ;; *) echo set ;; esac ;;
  set)
    case "$cur" in ""|"!"|"*"|"!*") ;; *) echo "password already set" >&2; exit 1 ;; esac
    IFS= read -r pw || exit 1
    [ -n "$pw" ] || { echo "empty password" >&2; exit 1; }
    case "$pw" in *:*) echo "':' is not allowed" >&2; exit 1 ;; esac
    printf '%s:%s\n' "$U" "$pw" | chpasswd || exit 1
    echo ok ;;
  *) echo "usage: $0 status|set" >&2; exit 2 ;;
esac
