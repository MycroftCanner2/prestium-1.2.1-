# Prestium 2.0 r9: protected settings, administration password set at login. Every use asks for it
# (the root password, never cached), so a compromised app can't change these silently.
Cmnd_Alias PRESTIUM_SENSITIVE = /usr/local/sbin/prestium-tor-mode apply, /usr/local/sbin/prestium-tor-mode revert, /usr/local/bin/prestium-tunnel-hops ^[1-7]$, /usr/local/sbin/prestium-i2p-reseed --file /*, /usr/bin/date ^(-u )?(-s|--set) [0-9][0-9A-Za-z.+_\:-]*( [0-9A-Za-z.+_\:][0-9A-Za-z.+_\:-]*)*$
Defaults:user rootpw, timestamp_timeout=0, passwd_tries=3, lecture=never
user ALL=(root) PASSWD: PRESTIUM_SENSITIVE
