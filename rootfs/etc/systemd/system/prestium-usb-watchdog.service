# Prestium 1.8: power off immediately when the boot medium is removed.
[Unit]
Description=Prestium emergency shutdown on boot medium removal
After=local-fs.target memlockd.service
Wants=memlockd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/prestium-usb-watchdog
Restart=on-failure
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
