<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://openbox.org/
                file:///usr/share/openbox/menu.xsd">

<menu id="root-menu" label="Openbox 3">
  <item label="Web Browser (I2P)">
    <action name="Execute"><execute>librewolf-i2p</execute></action>
  </item>
  <item label="Tor Browser">
    <action name="Execute"><execute>tor-browser</execute></action>
  </item>
  <item label="I2P Router Console">
    <action name="Execute"><execute>/usr/local/bin/prestium-i2p-console</execute></action>
  </item>
  <separator />
  <item label="Text Editor">
    <action name="Execute"><execute>featherpad</execute></action>
  </item>
  <item label="File Manager">
    <action name="Execute"><execute>pcmanfm</execute></action>
  </item>
  <separator />
  <menu id="/Office" label="Office">
    <item label="LibreOffice Writer">
      <action name="Execute"><execute>libreoffice --writer</execute></action>
    </item>
    <item label="LibreOffice Calc">
      <action name="Execute"><execute>libreoffice --calc</execute></action>
    </item>
    <item label="LibreOffice Math">
      <action name="Execute"><execute>libreoffice --math</execute></action>
    </item>
    <item label="LibreOffice Impress">
      <action name="Execute"><execute>libreoffice --impress</execute></action>
    </item>
    <item label="LibreOffice Draw">
      <action name="Execute"><execute>libreoffice --draw</execute></action>
    </item>
  </menu>
  <menu id="/Multimedia" label="Multimedia">
    <item label="Volume Control">
      <action name="Execute"><execute>pavucontrol</execute></action>
    </item>
    <item label="Audacity">
      <action name="Execute"><execute>audacity</execute></action>
    </item>
    <item label="Gimp">
      <action name="Execute"><execute>gimp</execute></action>
    </item>
    <item label="VLC Media player">
      <action name="Execute"><execute>vlc</execute></action>
    </item>
  </menu>
  <menu id="/Accessories" label="Accessories">
    <item label="Feather Wallet (Monero)">
      <action name="Execute"><execute>feather</execute></action>
    </item>
    <item label="SpeedCrunch Calculator">
      <action name="Execute"><execute>speedcrunch</execute></action>
    </item>
    <item label="Archive Manager">
      <action name="Execute"><execute>file-roller</execute></action>
    </item>
    <item label="Image Viewer">
      <action name="Execute"><execute>ristretto</execute></action>
    </item>
    <item label="KeePassXC">
      <action name="Execute"><execute>keepassxc</execute></action>
    </item>
    <item label="Unlock VeraCrypt Volume">
      <action name="Execute"><execute>/usr/local/bin/prestium-unlock-veracrypt</execute></action>
    </item>
    <item label="GPG Frontend">
      <action name="Execute"><execute>gpgfrontend</execute></action>
    </item>
    <item label="QR Generator">
      <action name="Execute"><execute>qtqr</execute></action>
    </item>
  </menu>
 <menu id="/Communication" label="Communication">
    <item label="Gajim XMPP">
      <action name="Execute"><execute>gajim</execute></action>
    </item>
    <item label="I2P Torrents">
      <action name="Execute"><execute>/usr/local/bin/prestium-torrents</execute></action>
    </item>
    <item label="IRC (The Lounge)">
      <action name="Execute"><execute>/usr/local/bin/prestium-irc</execute></action>
    </item>
    <item label="OnionShare">
      <action name="Execute"><execute>onionshare</execute></action>
    </item>
    <item label="Sylpheed E-mail">
      <action name="Execute"><execute>sylpheed</execute></action>
    </item>
  </menu>
  <separator />
  <menu id="/Network" label="Network">
    <menu id="/Network/Hops" label="I2P Tunnel Hops">
      <item label="1 hop">
        <action name="Execute"><execute>prestium-tunnel-hops 1</execute></action>
      </item>
      <item label="2 hops">
        <action name="Execute"><execute>prestium-tunnel-hops 2</execute></action>
      </item>
      <item label="3 hops (default)">
        <action name="Execute"><execute>prestium-tunnel-hops 3</execute></action>
      </item>
      <item label="4 hops">
        <action name="Execute"><execute>prestium-tunnel-hops 4</execute></action>
      </item>
      <item label="5 hops">
        <action name="Execute"><execute>prestium-tunnel-hops 5</execute></action>
      </item>
      <item label="6 hops">
        <action name="Execute"><execute>prestium-tunnel-hops 6</execute></action>
      </item>
      <item label="7 hops">
        <action name="Execute"><execute>prestium-tunnel-hops 7</execute></action>
      </item>
    </menu>
    <item label="Restart I2P (i2pd)">
      <action name="Execute"><execute>sh -c "systemctl restart i2pd || sudo -n systemctl restart i2pd"</execute></action>
    </item>
    <item label="Tor Monitor (Nyx)">
      <action name="Execute"><execute>x-terminal-emulator -e nyx</execute></action>
    </item>
  </menu>
  <separator />
  <menu id="/System" label="System">
    <item label="Terminal">
      <action name="Execute"><execute>x-terminal-emulator</execute></action>
    </item>
    <item label="Display Resolution">
      <action name="Execute"><execute>arandr</execute></action>
    </item>
    <item label="Virtual Keyboard">
      <action name="Execute"><execute>onboard</execute></action>
    </item>
    <separator />
    <menu id="/Openbox" label="Openbox">
      <item label="Window Manager Settings">
        <action name="Execute"><execute>obconf</execute></action>
      </item>
      <item label="Restart Window Manager">
        <action name="Restart" />
      </item>
      <item label="Exit Window Manager">
        <action name="Exit" />
      </item>
    </menu>
  </menu>
  <separator />
  <item label="Reboot">
    <action name="Execute">
      <prompt>Are you sure?</prompt>
      <execute>sh -c "systemctl reboot || sudo -n systemctl reboot"</execute>
    </action>
  </item>
  <item label="Shutdown">
    <action name="Execute">
       <prompt>Are you sure?</prompt>
       <execute>sh -c "systemctl poweroff || sudo -n systemctl poweroff"</execute>
    </action>
  </item>
</menu>

</openbox_menu>
