#!/bin/sh
# Prestium: set up i2pd's built-in torrent client (i2pd 3.0) each boot.
# - downloads go to /home/user/Downloads/Torrents (shared with "user" through
#   the i2ptorrents group)
# - the RPC/web page sits on 127.0.0.1 behind a random per-boot path, because
#   i2pd answers RPC with "Access-Control-Allow-Origin: *": without the secret
#   path any web page could add or delete torrents.
set -e
D=/home/user/Downloads/Torrents
# Debian 13 creates homes 0700 (1.8/Debian 12: 0755); i2pd must be able to
# traverse /home/user to reach the torrent dir. 1.9.1: grant search permission
# to group i2ptorrents (members: user, i2pd) only, not to every account.
chgrp i2ptorrents /home/user
chmod 0710 /home/user
install -d -o user -g user -m 0755 /home/user/Downloads
install -d -o user -g i2ptorrents -m 2770 "$D"
TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
install -d -o i2pd -g i2pd -m 0750 /var/lib/i2pd/tunnels.conf.d
cat > /var/lib/i2pd/tunnels.conf.d/torrents.conf <<CONF
[Torrents]
type = torrents
torrentsdir = $D
keys = transient-torrents
dht = true
web = true
rpcaddress = 127.0.0.1
rpcport = 7685
rpcpath = $TOKEN
CONF
chown i2pd:i2pd /var/lib/i2pd/tunnels.conf.d/torrents.conf
chmod 0640 /var/lib/i2pd/tunnels.conf.d/torrents.conf
install -d -o root -g user -m 0750 /run/prestium-torrents
printf 'http://127.0.0.1:7685/%s/\n' "$TOKEN" > /run/prestium-torrents/url
chgrp user /run/prestium-torrents/url; chmod 0640 /run/prestium-torrents/url
