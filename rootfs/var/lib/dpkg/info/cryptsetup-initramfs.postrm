#! /bin/sh

set -e

case "$1" in
    remove)
	if which update-initramfs >/dev/null; then
		update-initramfs -u
	fi
    ;;
esac

# Automatically added by dh_installdebconf/13.3.4
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi
# End automatically added section

