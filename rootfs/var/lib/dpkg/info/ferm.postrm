#!/bin/sh
set -e

rm -f /var/cache/ferm/*.sh /var/cache/ferm/*.tmp

if [ "$1" = "purge" ]; then
	rm -f /etc/default/ferm
fi

# Automatically added by dh_installinit/13.3
if [ "$1" = "purge" ] ; then
	update-rc.d ferm remove >/dev/null
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.3
if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.3
if [ "$1" = "remove" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper mask 'ferm.service' >/dev/null || true
	fi
fi

if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'ferm.service' >/dev/null || true
		deb-systemd-helper unmask 'ferm.service' >/dev/null || true
	fi
fi
# End automatically added section
# Automatically added by dh_installdebconf/13.3
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi
