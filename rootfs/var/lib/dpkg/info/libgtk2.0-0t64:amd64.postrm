#!/bin/sh

set -e



case "$1" in
    (purge)
        if [ -d /usr/lib/x86_64-linux-gnu/gtk-2.0/2.10.0 ] && ! [ -e /usr/lib/x86_64-linux-gnu/gtk-2.0/2.10.0/immodules ]; then
            # Purge the cache
            rm -f /usr/lib/x86_64-linux-gnu/gtk-2.0/2.10.0/immodules.cache
            rmdir -p --ignore-fail-on-non-empty /usr/lib/x86_64-linux-gnu/gtk-2.0/2.10.0
        fi
        ;;
esac
