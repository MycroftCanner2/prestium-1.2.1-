#!/bin/sh

set -e

case "${1}" in
	purge)
		rmdir --ignore-fail-on-non-empty /etc/live/boot > /dev/null 2>&1 || true
		rmdir --ignore-fail-on-non-empty /etc/live > /dev/null 2>&1 || true
		;;

	remove)
		# Restore original os-release when installing to rootfs,
		# as the IMAGE_ID= and similar fields are only valid for the
		# read-only live environment created by live-build, but not
		# for an installed rootfs, which
		if [ -f /etc/os-release ] && [ ! -L /etc/os-release ] && grep -q IMAGE_ID=live /etc/os-release; then
			rm -f /etc/os-release
			ln -s ../usr/lib/os-release /etc/os-release > /dev/null 2>&1 || true
		fi
		;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
		;;

	*)
		echo "postrm called with unknown argument \`${1}'" >&2
		exit 1
		;;
esac



exit 0
