#!/bin/sh
set -e

# Automatically added by dh_python3
if command -v py3compile >/dev/null 2>&1; then
	py3compile -p onionshare 
fi
if command -v pypy3compile >/dev/null 2>&1; then
	pypy3compile -p onionshare  || true
fi

if command -v py3compile >/dev/null 2>&1; then
	py3compile -p onionshare /usr/share/onionshare
fi
if command -v pypy3compile >/dev/null 2>&1; then
	pypy3compile -p onionshare /usr/share/onionshare || true
fi

# End automatically added section
